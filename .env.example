# Agentic Wallet (from onchainos wallet addresses)
WALLET_ADDRESS=0x<your-X-Layer-EVM-address>

# OKX SA API — required for x402 payment settlement
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# AWS Bedrock (Claude Sonnet 4.6)
AWS_PROFILE=my-bedrock-profile
AWS_REGION=us-east-1

# Server
PORT=3000

# Buyer script (for self-testing + revenue generation)
BUYER_PRIVATE_KEY=0x<buyer-wallet-private-key>
GLOWFY_URL=https://glowfy.onrender.com
LOOP_DELAY_MS=5000
MAX_ROUNDS=0
